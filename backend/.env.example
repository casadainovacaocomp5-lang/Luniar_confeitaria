"""
Arquivo .env - Environment Variables
Copie e complete com seus dados reais
"""

# Flask
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=sua-chave-super-secreta-aqui

# Database
SQLALCHEMY_DATABASE_URI=sqlite:///luniar_confeitaria.db

# Email (Gmail SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-app-gmail

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=seu-account-sid
TWILIO_AUTH_TOKEN=seu-auth-token
TWILIO_WHATSAPP_NUMBER=+5511999999999

# Admin
ADMIN_EMAIL=admin@luniarconfeitaria.com
ADMIN_PASSWORD=mudar-esta-senha-em-producao

# Configurações da Aplicação
LUNIAR_PHONE=5511999999999
LUNIAR_EMAIL=contato@luniarconfeitaria.com
